+    function mx(a, c) { return a > c ? a : c }
+    function cell(v, fv, lim, fmt) {
+        return sprintf(fmt, v) "_(" (fv == "" ? "n/a" : sprintf(fmt, fv)) "_/_" sprintf(fmt, lim) ")" }
+    BEGIN {
+        b += 0; q += 0; top += 0; k += 0; p += 0; t += 0; tt += 0; kt += 0; pt += 0; f += 0
+        # worst calibration values over the calibration runs (all validated by the caller)
+        n = split(fl, runs, ";"); rf = df = kf = pf = ""
+        for (i = 1; i <= n; i++) {
+            if (split(runs[i], s, " ") < 4) continue
+            d = s[1] / b - 1; if (d < 0) d = -d
+            rf = rf == "" ? d : mx(rf, d)
+            df = df == "" ? 100 - s[2] : mx(df, 100 - s[2])
+            kf = kf == "" ? s[3] + 0 : mx(kf, s[3] + 0)
+            pf = pf == "" ? s[4] + 0 : mx(pf, s[4] + 0)
